// firestore.rules
// Deploy via: firebase deploy --only firestore:rules
// Or paste directly into the Firebase Console → Firestore → Rules tab.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────

    // Returns true if the requester is signed in.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns the caller's user document from the 'users' collection.
    function callerUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Returns true only when the caller's Firestore user doc has role == "admin".
    // This is the critical server-side check — client-side role state is never trusted.
    function isAdmin() {
      return isAuthenticated() && callerUserDoc().role == "admin";
    }

    // ── Users Collection ──────────────────────────────────────────────────────
    // Users can read their own document; admins can read any user doc (for role
    // look-ups).  Users can create and update their own doc, but the `role` field
    // is never writable from the client — manage roles and deletes in the Firebase
    // Console or via a trusted admin backend.
    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated()
                     && request.auth.uid == userId
                     && !request.resource.data.keys().hasAny(["role"]);
      allow update: if isAuthenticated()
                     && request.auth.uid == userId
                     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
    }

    // ── Products Collection ───────────────────────────────────────────────────
    // Any authenticated user can READ products.
    // Only admins (role == "admin" in their users/{uid} doc) can CREATE, UPDATE, or DELETE.
    match /products/{productId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    // Prevent clients from changing the document ID field.
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["id"]);
      allow delete: if isAdmin();
    }
  }
}
